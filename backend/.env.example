# AI Sports Betting MVP - Environment Variables
# Copy this file to .env and fill in your actual values

# Application Settings
APP_NAME="AI Sports Betting MVP"
DEBUG=True

# Database Configuration
DATABASE_URL="postgresql://sports_user:sports_pass@localhost:5432/sports_betting_ai"

# API Keys - The Odds API
# Backend reads ODDS_API_KEY (preferred) or ODDS_API — both work after config alias fix
ODDS_API_KEY="your_odds_api_key_here"  # Get from https://the-odds-api.com/
# ODDS_API="your_odds_api_key_here"  # alias accepted if dashboard uses this name

# OpenAI API for AI predictions
OPENAI_API_KEY="your_openai_api_key_here"  # Get from https://platform.openai.com/

# Weather API (optional for game conditions)
WEATHER_API_KEY="your_weather_api_key_here"

# Ballpark Pal MLB projections (https://www.ballparkpal.com/api/docs/)
# BALLPARK_PAL_ENABLED=0
# BALLPARK_PAL_API_KEY=
# BPP_GAME_PRIOR_WEIGHT=0.30
# BPP_K_PRIOR_WEIGHT=0.25
# BPP_HITS_PRIOR_WEIGHT=0.25
# BPP_HR_PRIOR_WEIGHT=0.25

# Authentication
SECRET_KEY="your-production-secret-key-here-change-this"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Redis for caching
REDIS_URL="redis://localhost:6379"

# Payment Processing
STRIPE_SECRET_KEY="your_stripe_secret_key_here"

# SMS Notifications
TWILIO_ACCOUNT_SID="your_twilio_account_sid_here"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"

# Google OAuth Configuration (required for social login)
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_REDIRECT_URI=""  # Auto-determined by environment if not set

# CORS Configuration (optional - auto-determined by environment)
FRONTEND_URL=""  # Primary frontend URL
ALLOWED_ORIGINS=""  # Comma-separated list of allowed origins

# Email (Brevo API — required in production for verification/reset emails)
BREVO_API_KEY=""  # Brevo → SMTP & API → API keys
FROM_EMAIL="noreply@yetai.com"  # Must be a verified sender in Brevo
ENVIRONMENT="development"  # production | staging | development

# ETL — MLB HR ML (optional dingerParlay)
# MLB_HR_AUTO_BUILD=1
# MLB_HR_S3_PREFIX=s3://yetibets/mlb/
# MLB_LINEUP_CSV_S3=s3://yetibets/mlb/lineups_today.csv
# MLB_DAILY_FEATURES_S3=s3://yetibets/mlb/daily_features_today.csv
# MLB_HR_POWER_SCORES_S3=s3://yetibets/mlb/power_scores.csv
# MLB_HR_PITCHER_STATS_S3=s3://yetibets/mlb/pitcher_stats.csv
# MLB_HR_PARK_FACTORS_S3=s3://yetibets/mlb/park_factors.csv
# MLB_HR_WEATHER_S3=s3://yetibets/mlb/weather_normalized.csv
# MLB_HR_MODEL_S3=s3://yetibets/mlb/hr_model.pkl
# MLB_HR_TOP_N=50
# EV_MIN_EDGE=0

# ETL — NFL kicker ML (optional; falls back to backend/models/nfl/*.pkl)
# NFL calendar year the regular season starts in (September). Override in prod if needed.
# NFL_SEASON=2026
# NFL_MODELS_S3_PREFIX=s3://yetibets/nfl/
# NFL_KICKER_ML_BLEND_WEIGHT=0.35

# ETL — odds (MLB EV, NHL/NFL lines)
# ODDS_API_KEY=