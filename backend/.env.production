# Production Environment Variables for YetAI Sports Betting MVP
# This file contains template values - replace with actual production values

# Database Configuration (Railway PostgreSQL)
DATABASE_URL=postgresql://postgres:password@host:port/database_name

# Application Settings
ENVIRONMENT=production
DEBUG=False
HOST=0.0.0.0
PORT=8000

# JWT and Security
SECRET_KEY=your-super-secret-production-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Legacy name still supported via config alias:
# JWT_ACCESS_TOKEN_EXPIRES=720

# API Keys and External Services (set real secrets in Railway — never commit keys)
# ODDS_API_KEY is injected at runtime on Railway; do not use template values here.
SLEEPER_API_BASE=https://api.sleeper.app/v1

# Email Service (Optional - Resend)
RESEND_API_KEY=your-resend-api-key

# CORS Settings
ALLOWED_ORIGINS=https://yetai.app,https://www.yetai.app
FRONTEND_URL=https://yetai.app

# Google OAuth (Production)
GOOGLE_REDIRECT_URI=https://backend-production-f7af.up.railway.app/api/auth/google/callback

# Redis Cache (Optional - Railway Redis add-on)
REDIS_URL=redis://default:password@host:port

# Logging
LOG_LEVEL=INFO